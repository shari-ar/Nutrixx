# Nutrixx local runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000

# Browser access
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional direct-API curation settings. Development Compose enables the
# workspace-token workflow independently and creates its token under .temp.
NUTRIXX_CURATION_ENABLED=false
NUTRIXX_CURATION_TOKEN=

# Local-only GitHub publication. Use a fine-grained token with Contents:
# Read and write for this repository. The token is never exposed to Web clients.
NUTRIXX_GITHUB_TOKEN=
NUTRIXX_GITHUB_REPOSITORY=shari-ar/Nutrixx
