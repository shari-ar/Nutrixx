{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".devcontainer/prepare-local-catalog.mjs",
        ".devcontainer/serve-data-quality-radar.mjs",
        ".devcontainer/start-data-quality-radar.mjs",
        ".devcontainer/wait-for-services.mjs",
        "docs/.vitepress/config.mts",
        "docs/.vitepress/theme/index.ts",
        "scripts/build-multisource-food-catalog.mjs",
        "scripts/stage-4-browser-runner.mjs",
      ],
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/main.dev.ts"],
      "ignoreDependencies": ["@types/express"],
    },
    "apps/web": {
      "entry": [
        "app/acceptance/catalog/route.dev.ts",
        "app/acceptance/page.dev.tsx",
        "components/stage-4-acceptance-workspace.tsx",
        "lib/next-meal-acceptance-client.dev.ts",
        "lib/next-meal-full-catalog.acceptance.ts",
        "vitest.config.acceptance.ts",
        "workers/next-meal-acceptance.worker.dev.ts",
      ],
    },
    "packages/persistence": {
      "entry": ["src/index.ts", "src/contract-suite.ts"],
    },
  },
}
