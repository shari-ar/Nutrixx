{
  "name": "@nutrixx/user-context",
  "version": "0.1.0",
  "description": "Minimal local-first starting profile contracts and persistence service for Nutrixx.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "lint": "oxlint src/ vitest.config.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/canonical-schema": "0.1.0",
    "@nutrixx/persistence": "0.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nutrixx/persistence-indexeddb": "0.1.0",
    "fake-indexeddb": "6.2.5",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
