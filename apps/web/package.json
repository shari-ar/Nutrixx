{
  "name": "@nutrixx/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/run-with-node-env.mjs production next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "next dev",
    "format": "prettier --write --ignore-path ../../.prettierignore \"{app,components,config,styles,types}/**/*.{css,js,jsx,json,md,mdx,ts,tsx}\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"{app,components,config,styles,types}/**/*.{css,js,jsx,json,md,mdx,ts,tsx}\" \"*.{json,md,mjs,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "start": "next start",
    "test": "vitest run --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest watch --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/config": "0.1.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@next/env": "16.3.6",
    "clsx": "2.1.1",
    "intl-messageformat": "11.2.14",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.2"
  }
}
