{
  "name": "@nutrixx/persistence-postgresql",
  "version": "0.1.0",
  "description": "PostgreSQL adapter for Nutrixx canonical records.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "lint": "oxlint src/ vitest.config.ts",
    "test": "vitest run --passWithNoTests --exclude \"src/**/*.integration.test.ts\"",
    "test:contract": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/canonical-schema": "0.1.0",
    "@nutrixx/persistence": "0.1.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "8.23.1",
    "oxlint": "^1.58.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
