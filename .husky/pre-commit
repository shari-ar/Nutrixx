if command -v npm >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACMR -z |
    xargs -0 -r npm exec --offline -- prettier --write --ignore-unknown --
elif command -v docker >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACMR -z |
    docker compose \
    -f infra/compose/compose.yaml \
    -f infra/compose/compose.dev.yaml \
    exec -T api xargs -0 -r npm exec --offline -- prettier --write --ignore-unknown --
else
  echo 'Nutrixx pre-commit formatting could not run.' >&2
  echo 'Start the DevContainer or install the locked Node.js/npm toolchain.' >&2
  exit 1
fi

git update-index --again
