{
  "name": "Nutrixx Development",
  "dockerComposeFile": [
    "../infra/compose/compose.yaml",
    "../infra/compose/compose.dev.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "api",
  "runServices": ["api", "web", "radar"],
  "workspaceFolder": "/workspace",
  "initializeCommand": [
    "docker",
    "buildx",
    "bake",
    "--allow=fs.read=infra/docker/Dockerfile",
    "--load",
    "--set=*.context=.",
    "--set=*.dockerfile=infra/docker/Dockerfile",
    "-f",
    "infra/compose/compose.yaml",
    "-f",
    "infra/compose/compose.dev.yaml",
    "api",
    "web"
  ],
  "forwardPorts": [3000, 3001, 3002],
  "portsAttributes": {
    "3000": {
      "label": "Nutrixx Web",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "Nutrixx API",
      "onAutoForward": "silent"
    },
    "3002": {
      "label": "Nutrixx Data Quality Radar",
      "onAutoForward": "openBrowser"
    }
  },
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postStartCommand": "node .devcontainer/wait-for-services.mjs",
  "waitFor": "postStartCommand",
  "remoteUser": "root",
  "updateRemoteUserUID": false
}
