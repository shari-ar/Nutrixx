{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": {
      "type": "tsc",
      "options": {
        "configPath": "tsconfig.build.json"
      }
    },
    "deleteOutDir": true,
    "manualRestart": true
  }
}
