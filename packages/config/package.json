{
  "name": "@nutrixx/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration presets for the Nutrixx monorepo.",
  "files": [
    "application.d.mts",
    "application.mjs",
    "environment.d.mts",
    "environment.mjs",
    "prettier.mjs",
    "typescript",
    "vitest.d.mts",
    "vitest.mjs",
    "workspaces.d.mts",
    "workspaces.mjs"
  ],
  "exports": {
    "./application": {
      "types": "./application.d.mts",
      "default": "./application.mjs"
    },
    "./environment": {
      "types": "./environment.d.mts",
      "default": "./environment.mjs"
    },
    "./prettier": "./prettier.mjs",
    "./typescript/strict": "./typescript/strict.json",
    "./typescript/node": "./typescript/node.json",
    "./vitest": {
      "types": "./vitest.d.mts",
      "default": "./vitest.mjs"
    },
    "./workspaces": {
      "types": "./workspaces.d.mts",
      "default": "./workspaces.mjs"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
