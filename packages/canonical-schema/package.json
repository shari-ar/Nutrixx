{
  "name": "@nutrixx/canonical-schema",
  "version": "0.1.0",
  "description": "Storage-neutral canonical data contracts for Nutrixx.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/v1": "./dist/canonical-record-v1.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node write-json-schema.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write \"src/**/*.{md,ts}\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{md,ts}\" \"*.{json,md,mjs,ts}\"",
    "lint": "oxlint src/ vitest.config.ts",
    "lint:fix": "oxlint --fix src/ vitest.config.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest watch --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.58.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
