{
  "name": "@nutrixx/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/run-with-node-env.mjs production next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "next dev",
    "format": "prettier --write --ignore-path ../../.prettierignore \"{app,components,config,lib,styles,types}/**/*.{css,js,jsx,json,md,mdx,ts,tsx}\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"{app,components,config,lib,styles,types}/**/*.{css,js,jsx,json,md,mdx,ts,tsx}\" \"*.{json,md,mjs,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "start": "next start",
    "test": "vitest run --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest watch --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/canonical-schema": "0.1.0",
    "@nutrixx/config": "0.1.0",
    "@nutrixx/persistence-indexeddb": "0.1.0",
    "@nutrixx/user-context": "0.1.0",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@next/env": "16.3.5",
    "clsx": "2.1.1",
    "intl-messageformat": "10.7.16",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.9.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-unused-imports": "4.1.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "vitest": "^4.1.2"
  }
}
