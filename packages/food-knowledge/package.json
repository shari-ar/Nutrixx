{
  "name": "@nutrixx/food-knowledge",
  "version": "0.1.0",
  "description": "Storage-neutral food catalog models, release tooling, and local query services for Nutrixx.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "catalog:build:usda": "npm run build && node --max-old-space-size=4096 build-usda-release.mjs",
    "catalog:verify": "npm run build && node --max-old-space-size=4096 verify-food-catalog-release.mjs",
    "format": "prettier --write \"src/**/*.{md,ts}\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{md,ts}\" \"*.{json,md,mjs,ts}\"",
    "lint": "oxlint src/ vitest.config.ts build-usda-release.mjs verify-food-catalog-release.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/canonical-schema": "0.1.0",
    "@nutrixx/persistence": "0.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nutrixx/persistence-indexeddb": "0.1.0",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "6.2.5",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
