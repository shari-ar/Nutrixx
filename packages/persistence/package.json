{
  "name": "@nutrixx/persistence",
  "version": "0.1.0",
  "description": "Storage-neutral persistence contracts for Nutrixx canonical records.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/contract-suite.d.ts",
      "import": "./dist/contract-suite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{md,ts}\" \"*.{json,md,ts}\"",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@nutrixx/canonical-schema": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
